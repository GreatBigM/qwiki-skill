#!/bin/sh
# 发布前检查 —— 任一命中即拒绝推送（这是唯一「不会忘」的检查点）。
# 启用（每个克隆各做一次）：git config core.hooksPath scripts/hooks
# 确认命中项无碍时：git push --no-verify

ROOT="$(git rev-parse --show-toplevel)"

# 守卫自身的测试：check / sync 的边界行为（缺 `>` 不覆盖总结 / 出处首行 / 空段补表头 / 表体断裂 …）。
# 放在最前——守卫坏了，后面所有"通过"都不作数。
python3 "$ROOT/scripts/qwiki-tests.py" >/dev/null || {
  echo "✗ 核心测试未通过 —— 拒绝推送（python3 scripts/qwiki-tests.py 看明细）" >&2
  exit 1
}

# 先验规则本身：闸门规则被改坏了，扫描再"通过"也不作数（自检与扫描共用同一份口径，见 publish-check.py 的 line_hits）
python3 "$ROOT/scripts/publish-check.py" --self-test || {
  echo "✗ 闸门自检失败（规则表被改动？）—— 拒绝推送" >&2
  exit 1
}

python3 "$ROOT/scripts/publish-check.py" || {
  echo "✗ 脱敏检查未通过 —— 拒绝推送（真实标识换占位符；确认无碍可 --no-verify）" >&2
  exit 1
}

python3 "$ROOT/scripts/number-audit.py" || {
  echo "✗ 数字审计未通过 —— 拒绝推送（宪法与对外文档不得含实测数字：样本挪进知识库的卡，或改成公式）" >&2
  exit 1
}

# 改了技能本体就必须同时改 CHANGELOG（"改了实现忘了记录"这一形状已复发多次）
# 名单 = 随安装下发、或改变用户拿到的东西：SKILL / SCHEMA / install.sh / templates / references / scripts / assets。
# README.md 有意不入列——它是对外首页，随 CHANGELOG 一起看即可，强制它只会制造噪声。
BASE=$(git rev-parse --verify -q origin/main || git rev-parse --verify -q gitee/main \
       || git rev-list --max-parents=0 HEAD | tail -1)
if [ -n "$BASE" ]; then
  CHANGED=$(git diff --name-only "$BASE"..HEAD 2>/dev/null || true)
  if printf '%s\n' "$CHANGED" | grep -qE '^(SKILL\.md|SCHEMA\.md|install\.sh|templates/|references/|scripts/|assets/)'; then
    printf '%s\n' "$CHANGED" | grep -q '^CHANGELOG\.md$' || {
      echo "✗ 改了技能本体（SKILL.md / SCHEMA.md / install.sh / templates/ / references/ / scripts/ / assets/ 之一）但 CHANGELOG.md 没跟上" >&2
      echo "  → 补一条本版本条目再推" >&2
      exit 1
    }
  fi
fi
